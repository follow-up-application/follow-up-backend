{
  "info": {
    "name": "Follow-up Backend API",
    "_postman_id": "follow-up-backend-collection",
    "description": "Colección de Postman para la API REST del sistema Follow-up (Laravel 11). Base URL: http://127.0.0.1:8000/api/v1\n\nAutenticación: Laravel Sanctum (Bearer token). Obtener token con POST /login y usarlo en el header Authorization: Bearer <token>.\n\nRoles: administrador, docente, tutor, alumno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"alumno@mail.com\",\n    \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "login"]
            },
            "description": "Inicia sesión y devuelve un token Bearer. Guardar el token para usarlo en endpoints protegidos."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "logout"]
            },
            "description": "Cierra la sesión eliminando el token actual."
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"password\": \"nuevaPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "password"]
            },
            "description": "Cambia la contraseña del usuario autenticado. Cualquier rol autenticado."
          }
        }
      ]
    },
